# 防止目录浏览
# Options -Indexes

# 防止访问敏感文件
# <FilesMatch "\.(db|bak|sql|log|ini)$">
#     Order allow,deny
#     Deny from all
# </FilesMatch>

# 防止直接访问 layout 文件
# <FilesMatch "^layout_">
#     Order allow,deny
#     Deny from all
# </FilesMatch>

# 启用 URL 重写（如果需要隐藏 admin 目录）
# RewriteEngine On
# RewriteBase /admin/

# 防止 SQL 注入和 XSS 攻击
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
#     RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
#     RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
#     RewriteRule ^(.*)$ index.php [F,L]
# </IfModule>

# 限制请求方法
# <LimitExcept GET POST>
#     Order deny,allow
#     Deny from all
# </LimitExcept>

# 注意：.htaccess 已暂时禁用，用于调试
# 如果后台正常工作，可以逐步启用上述规则
